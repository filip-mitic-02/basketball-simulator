# Public URL of the deployment, no trailing slash. Used to build the OAuth redirect and to check request origins.
BASE_URL=http://localhost:3000
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 random bytes:  openssl rand -base64 48
SESSION_SECRET=
# Neon / Vercel Postgres connection string (the Vercel Neon integration sets this for you)
DATABASE_URL=
